# Example config — copy to mcp-guard.toml

[scan]
host = "127.0.0.1"
ports = [50551, 52412, 3000, 8080]
connect_timeout_ms = 400
http_timeout_ms = 800
# Raise EXPOSURE ALERT when CORS*/auth heuristics fire (not only audit)
alert_on_exposure = true

[audit]
path = "mcp-guard-audit.jsonl"

[serve]
interval_secs = 30

[gate]
# Substring match on process name or exe path (case-insensitive)
allow_process_names = ["mcp-guard", "WorkBuddy", "CodeBuddy", "node"]
alert_on_unknown = true

[vault]
store_path = "mcp-guard-vault.enc"
key_path = "mcp-guard-vault.key"
ref_ttl_secs = 600

[git_scan]
max_file_bytes = 5000000
# extensions = [".json", ".jsonl", ".ndjson", ".txt", ".md", ".log"]
# exclude_substrings = ["cases/arxiv-2608-09867/fixtures/", "experiments/git-cipher-scan/"]
